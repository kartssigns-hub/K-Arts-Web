# ---------- Firebase (Firebase console → Project settings → Your apps) ----------
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------- Backend ----------
# Express + Socket.IO server. Defaults to https://k-artz-server.onrender.com when empty.
VITE_API_URL=http://localhost:5000

# ---------- Analytics ----------
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------- Monitoring (Sentry, browser errors) ----------
# Error tracking is disabled when empty, and never reports from `npm run dev`.
VITE_SENTRY_DSN=
# Defaults to the Vite mode ("production")
VITE_SENTRY_ENVIRONMENT=
# Fraction of page loads traced for performance (0 to 1)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
